# Copie para `.env` e preencha (não commite segredos).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: Sentry (DSN público do projecto — configurar também no EAS para builds).
EXPO_PUBLIC_SENTRY_DSN=

# JWT Auth: por omissão activo (bootstrap após login se auth_user_id ligado).
# EXPO_PUBLIC_ISO_PRO_JWT_AUTH=false
